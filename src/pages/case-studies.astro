---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE } from '../consts';

const pageDescription = "Real small business SEO case studies from Your Friendly SEO. Detailed client stories are being added, with measured outcomes and client quotes.";
---

<Layout title={`Case Studies | ${SITE_TITLE}`} description={pageDescription}>
  <main class="case-studies-page">
    <section class="hero">
      <div class="container">
        <h1>SEO Case Studies</h1>
        <p class="subtitle">Honest, measured results from real small business SEO work.</p>
      </div>
    </section>

    <section class="content">
      <div class="container">
        <div class="status-card">
          <h2>Detailed client stories are on the way</h2>
          <p>
            I'm putting together full case studies, and I only publish stories I can back up: a real business type, the starting problem, exactly what was done, and the measured outcome, with a client quote. Rather than fill this page with made-up numbers, I'd rather show you the real thing when it's ready.
          </p>
          <p>
            In the meantime, if you want to see whether I've worked on something similar to your situation, just ask. I'm happy to walk you through a relevant example on a call or over email.
          </p>
          <a href="/contact" class="cta">Request a relevant example</a>
        </div>

        <div class="meanwhile">
          <h3>While you're here</h3>
          <ul>
            <li><a href="/consultation">Book a 1-on-1 strategy session</a></li>
            <li><a href="/services">See SEO services</a></li>
            <li><a href="/free-checklist">Get the free SEO checklist</a></li>
          </ul>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .case-studies-page { background: #F8FAFC; }
  .container { max-width: 820px; margin: 0 auto; padding: 0 20px; }

  .hero {
    background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
    color: #fff;
    padding: 48px 20px 44px;
    text-align: center;
  }
  .hero h1 { font-size: 2.5rem; margin-bottom: 12px; color: #fff; }
  .hero .subtitle { font-size: 1.15rem; color: rgba(255,255,255,0.85); margin: 0; }
  @media (max-width: 768px) { .hero h1 { font-size: 1.9rem; } }

  .content { padding: 52px 20px; }

  .status-card {
    background: #fff;
    border: 1px solid #E2E8F0;
    border-left: 4px solid #F59E0B;
    border-radius: 12px;
    padding: 36px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  }
  .status-card h2 { font-size: 1.5rem; color: #0F172A; margin: 0 0 16px; }
  .status-card p { color: #475569; line-height: 1.7; margin: 0 0 16px; }

  .cta {
    display: inline-block;
    margin-top: 8px;
    background: #F59E0B;
    color: #0F172A;
    padding: 14px 28px;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s;
  }
  .cta:hover { background: #D97706; text-decoration: none; }

  .meanwhile { margin-top: 36px; }
  .meanwhile h3 { font-size: 1.1rem; color: #0F172A; margin: 0 0 12px; }
  .meanwhile ul { list-style: none; padding: 0; margin: 0; }
  .meanwhile li { margin-bottom: 10px; }
  .meanwhile a { color: #D97706; font-weight: 600; }
</style>
